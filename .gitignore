# Secrets / credentials — never commit these
.env
.env.*
*.pem
*.key
*.secret
credentials.json
vault_password

# OS / editor cruft
.DS_Store
*.swp
*~

# engineering-team run artifacts — working state, not deliverables.
# The skill writes evaluation reports, plans, and progress dashboards here.
.engineering-team/

# Python bytecode. The engineering-team skill ships one script; the skill dir
# is deployed verbatim to ~/.claude/skills/, so a stray __pycache__ would be
# copied into it on every deploy.
__pycache__/
*.pyc

# Per-run setup logs and run records (working state, not deliverables).
.setup-logs/
